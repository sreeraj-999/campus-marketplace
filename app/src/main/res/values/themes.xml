<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with Material 3 styling -->
    <style name="Base.Theme.CampusMarketplace" parent="Theme.Material3.Light.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryDark">@color/dark_blue</item>
        <item name="colorSecondary">@color/light_blue</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorSurface">@color/white_cards</item>
        <item name="colorOnSurface">@color/text_dark</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/dark_blue</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Material 3 Shape / Corner Overrides -->
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CampusMarketplace.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CampusMarketplace.Large</item>
    </style>

    <style name="Theme.CampusMarketplace" parent="Base.Theme.CampusMarketplace" />

    <!-- Splash Theme -->
    <style name="Theme.CampusMarketplace.Splash" parent="Theme.CampusMarketplace">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Custom Shapes -->
    <style name="ShapeAppearance.CampusMarketplace.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">18dp</item>
    </style>

    <style name="ShapeAppearance.CampusMarketplace.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Professional Rounded Elevated Card -->
    <style name="Widget.CampusMarketplace.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">6dp</item>
        <item name="cardBackgroundColor">@color/white_cards</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Primary Action Button -->
    <style name="Widget.CampusMarketplace.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="backgroundTint">@color/primary_blue</item>
    </style>

    <!-- Outlined Button -->
    <style name="Widget.CampusMarketplace.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/primary_blue</item>
        <item name="android:textColor">@color/primary_blue</item>
    </style>

    <!-- Text Input Layout -->
    <style name="Widget.CampusMarketplace.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/primary_blue</item>
        <item name="hintTextColor">@color/primary_blue</item>
    </style>
</resources>